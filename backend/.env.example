# Use only approved/licensed partner JSON feeds. A configured feed URL
# takes precedence; blank URLs use best-effort parsing of public search HTML.
# Default contract: {"offers":[{"id":"...","title":"...","price":1234.5,
# "currency":"RUB","url":"https://marketplace.example/product"}]}
# Wildberries may alternatively return native parser-shaped records:
# set MULTIMARKET_WB_FEED_FORMAT=wb_records and return {"products":[
# {"id":123456,"name":"Product","salePriceU":123400,"priceU":159900,
#  "brand":"Brand","totalQuantity":5,"image_links":"https://cdn.example/img.webp"}]}
# WB salePriceU/priceU and nested size price values are interpreted as kopecks.
# Search only the listed marketplaces; default is Yandex Market for quick local runs.
# Re-enable all three with: Ozon,Wildberries,Яндекс Маркет
MULTIMARKET_SEARCH_MARKETPLACES=Яндекс Маркет

# Feed URL/token must belong to an approved data provider. Never commit .env.
MULTIMARKET_OZON_FEED_URL=
MULTIMARKET_OZON_FEED_TOKEN=
MULTIMARKET_WB_FEED_URL=
MULTIMARKET_WB_FEED_TOKEN=
MULTIMARKET_WB_FEED_FORMAT=
MULTIMARKET_YM_FEED_URL=
MULTIMARKET_YM_FEED_TOKEN=

# Optional Telegram notifications for price changes (>= 10%).
MULTIMARKET_TELEGRAM_BOT_TOKEN=
MULTIMARKET_TELEGRAM_CHAT_ID=

# OAuth 2.0 sign-in. The callback URLs below are for local development on port 8000.
# Create a separate Web application client in Google and a Yandex ID login app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/auth/yandex/callback

# Yandex Maps: obtain a separate "JavaScript API and HTTP Geocoder" key.
# This browser key is public by design: restrict it to your site's domains.
# OAuth client ID/secret above cannot be used here. Never commit real keys.
YANDEX_MAPS_API_KEY=
# Separate Geosuggest API key. Used only on the server and never returned to browsers.
YANDEX_SUGGEST_API_KEY=
# Optional private Photon server for OSM pickup-point lookup and fallback address hints.
MULTIMARKET_PHOTON_URL=https://photon.komoot.io

# Comma-separated email addresses that receive the first admin role on sign-in.
MULTIMARKET_ADMIN_EMAILS=
# Use a long random value in deployments. A temporary value is generated if blank.
MULTIMARKET_SESSION_SECRET=
# Leave false for local HTTP. Set true when the site is served over HTTPS.
MULTIMARKET_COOKIE_SECURE=false
