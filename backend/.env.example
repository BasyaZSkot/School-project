# Use only approved/licensed partner JSON feeds.
# Endpoints accept ?q=<query>&limit=<n> and return:
# {"offers":[{"id":"...","title":"...","price":1234.5,"currency":"RUB",
#   "url":"https://marketplace.example/product","brand":"...","model":"...",
#   "gtin":"...","in_stock":true,"image_url":"https://..."}]}
#
# Put actual credentials in backend/.env. Never commit backend/.env.
MULTIMARKET_OZON_FEED_URL=
MULTIMARKET_OZON_FEED_TOKEN=
MULTIMARKET_WB_FEED_URL=
MULTIMARKET_WB_FEED_TOKEN=
MULTIMARKET_YM_FEED_URL=
MULTIMARKET_YM_FEED_TOKEN=
